$('export').onclick=()=>download('mandala-'+mode+'.json',JSON.stringify(data,null,2),'application/json');
$('importBtn').onclick=()=>$('import').click();
$('import').onchange=async e=>{let file=e.target.files[0];if(!file)return;try{let obj=JSON.parse(await file.text());if(!Array.isArray(obj.grid)||obj.grid.length!==9||obj.grid.some(row=>!Array.isArray(row)||row.length!==9))throw Error('invalid');data={grid:obj.grid.map(row=>row.map(v=>String(v||'').slice(0,500))),checks:obj.checks||{},reflection:String(obj.reflection||'').slice(0,3000)};saveLocal();render()}catch(err){alert('Invalid JSON Mandala file')}e.target.value=''};
$('downloadIcs').onclick=()=>{
 let v=prompt(lang==='ar'?'عنوان التذكير (اتركه فارغًا للإلغاء):':'Reminder title (leave empty to cancel):',data.grid[selected[0]][selected[1]]||'Review my Mandala');
 if(!v)return;let dt=prompt(lang==='ar'?'التاريخ YYYY-MM-DD':'Date YYYY-MM-DD',new Date().toISOString().slice(0,10));if(!/^\d{4}-\d{2}-\d{2}$/.test(dt)||isNaN(Date.parse(dt)))return alert('Invalid date');
 const escapeIcs=x=>String(x).replace(/\\/g,'\\\\').replace(/\n/g,'\\n').replace(/[,;]/g,m=>'\\'+m);
 const stamp=dt.replaceAll('-','');const evt=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Mandala Ikigai Website//EN','BEGIN:VEVENT','UID:'+Date.now()+'@mandala.local','DTSTAMP:'+new Date().toISOString().replace(/[-:]/g,'').replace(/\.\d{3}/,'').replace('Z','Z'),'DTSTART;VALUE=DATE:'+stamp,'SUMMARY:'+escapeIcs(v),'DESCRIPTION:'+escapeIcs('Review your Mandala goal'),'END:VEVENT','END:VCALENDAR'].join('\r\n');
 download('mandala-reminder.ics',evt,'text/calendar');};
applyLang();load('blank');
</script></body></html>
